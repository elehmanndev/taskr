# ── Server ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Taskr <noreply@example.com>
CLIENT_URL=https://taskr.example.com

# ── Database ─────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# Only needed if you run `npx prisma db push` / `prisma studio` outside Docker
# (inside the server container, DATABASE_URL is injected by docker-compose.yml).
# Points at the MySQL container via its host port (MYSQL_PORT above).
DATABASE_URL=mysql://taskr:change-me@localhost:3307/taskr

# ── Client ───────────────────────────────────────────────────────────────────
VITE_API_URL=https://taskr.example.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Create at: https://one.dash.cloudflare.com → Networks → Tunnels
# Add route: taskr.example.com → http://client:80
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# ── Unraid Ports (avoid conflicts with existing containers) ──────────────────
MYSQL_PORT=3307
REDIS_PORT=6380
SERVER_PORT=3001
CLIENT_PORT=3000

# ── Unraid Data Path (set to your appdata path) ─────────────────────────────
# DATA_PATH=/mnt/user/appdata/taskr

# ── Auto-deploy webhook ──────────────────────────────────────────────────────
# Shared secret between GitHub and the webhook container. Generate with:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=change-me-to-a-random-string
